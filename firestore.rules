rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Admin = e-mail bootstrap, liste config/admins.emails, ou doc admins/{uid}.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && (
          request.auth.token.email == 'moiseraidjy@gmail.com'
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          || (
            exists(/databases/$(database)/documents/config/admins)
            && request.auth.token.email
              in get(/databases/$(database)/documents/config/admins).data.emails
          )
        );
    }

    // Catalogue : lecture des approved pour tout authentifié ; admin voit tout.
    // Les propositions en attente vivent dans song_submissions, pas ici.
    match /songs/{songId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.status == 'approved');
      allow create: if isAdmin()
        && request.resource.data.status == 'approved';
      allow update, delete: if isAdmin();
    }

    // Propositions d'ajout / modification (file de modération).
    match /song_submissions/{submissionId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.createdBy == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.type in ['create', 'update']
        && request.resource.data.keys().hasAll([
          'type', 'status', 'createdBy', 'payload', 'createdAt'
        ]);

      allow update: if isAdmin()
        && request.resource.data.status in ['approved', 'rejected', 'pending'];

      allow delete: if isAdmin();
    }

    // Favoris scoped à l'utilisateur connecté uniquement.
    match /users/{userId}/favorites/{songId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Liste d'e-mails admin (lecture auth ; écriture console uniquement).
    match /config/admins {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Doc par uid admin (écriture console uniquement).
    match /admins/{uid} {
      allow read: if isSignedIn()
        && (request.auth.uid == uid || isAdmin());
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
