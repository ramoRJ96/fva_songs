rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catalogue partagé : lecture/écriture pour tout utilisateur authentifié (anonyme inclus).
    match /songs/{songId} {
      allow read, write: if request.auth != null;
    }

    // Favoris scoped à l'utilisateur connecté uniquement.
    match /users/{userId}/favorites/{songId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Bloque le reste par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
